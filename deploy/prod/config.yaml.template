workers:
  count: 2
  default_timeout: 300

queue:
  backend: sql  # was redis — SQLQueue polls `workflow_jobs` directly, closing the
  # at-most-once job-loss window in RedisQueue.pop() (BRPOP). requires jobs.persistence: sql.
  # See docs/concepts/UPGRADE-v2.md P14 / docs/compose/specs/2026-07-27-sql-job-queue-design.md.
  redis_url: redis://redis:6379/0
  redis_max_connections: 10
  redis_push_timeout: 5.0
  redis_pop_timeout: 1.0
  sql_poll_interval: 0.5

soar:
  workflows_dir: /app/data/workflows
  connectors_dir: /app/data/connectors
  actions_dir: /app/data/actions

git:
  workflows_repo: /app/data
  author_name: SOAR Orchestrator
  author_email: soar@local

logging:
  level: INFO
  file: /var/log/soar/orchestrator.log

jobs:
  log_dir: /var/log/soar/jobs
  keep_completed: 100
  persistence: sql  # memory | sql — sql persists job history in `database` across restarts
  retention_days: 90  # explicit opt-in — 0 would keep job history forever

database:
  url: postgresql+asyncpg://soar:${POSTGRES_PASSWORD}@postgres:5432/soar
  table_prefix: ""  # single-instance deploy — no table_prefix needed, see AGENTS.md Known Limitations #8

auth:
  secret_key: "${AUTH_SECRET_KEY}"
  # REQUIRED: set to the real UI origin(s) before going live — the code
  # default (localhost:3000/5173) will silently win otherwise and the UI
  # will fail to log in (browser CORS rejection), see UPGRADE-v2.md P17.
  # `soarctl init --interactive` (or `--cors-origin URL`) fills this in for
  # you; plain `soarctl init` leaves the placeholder below for manual edit.
  cors_origins: ${CORS_ORIGINS_JSON}

server:
  # IP of the `ui` (nginx) container on the `soar-net` docker network — see
  # docker-compose.yml networks.soar-net.ipam and ui.networks.soar-net.
  # ipv4_address. Keep both in sync when changing the network. Without this,
  # resolve_client_ip() sees nginx's own IP as client_ip for all traffic —
  # a global login rate-limit and a useless AuditLog.client_ip, see B4 in
  # docs/concepts/BAGFIX_PLAN.md.
  trusted_proxies: ["172.28.0.10"]
