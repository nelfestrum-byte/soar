FROM python:3.11-slim

# libcap2-bin: setcap, to grant setpriv cap_setuid/cap_setgid below (Фаза 4
# privilege narrowing) — setpriv itself already ships in util-linux, a base
# Debian dependency. git: workflows_repo version control.
RUN apt-get update && apt-get install -y git libcap2-bin && rm -rf /var/lib/apt/lists/*

RUN groupadd -r soar && useradd -r -g soar -d /app -s /sbin/nologin soar

# Separate, less-privileged identity for the job-runner subprocess (Фаза 4,
# docs/compose/specs/2026-07-30-privilege-narrowing-design.md [S3]) — fixed
# numeric ids so config.yaml's jobs.runner_uid/runner_gid stay correct
# across rebuilds (unlike `soar` above, whose id is left to `useradd -r`'s
# existing auto-assignment to avoid changing ownership on volumes from
# installs that predate this change). soar-runner is NOT in the `soar`
# group and gets no home/shell — it never logs in, only ever exec's via
# `setpriv --reuid=... --regid=...` from SubprocessRunner.
RUN groupadd -r --gid=5001 soar-runner && \
    useradd -r --uid=5001 -g soar-runner -d /app -s /sbin/nologin soar-runner

# setpriv carries the capability, not the python interpreter — any code
# under content-venv/platform-venv Python must NOT be able to self-elevate
# to another uid; only this specific, small, well-audited util-linux binary
# can, and only to switch into soar-runner for the runner subprocess exec.
RUN setcap cap_setuid,cap_setgid+ep /usr/bin/setpriv

WORKDIR /app

COPY soar/ /app/soar/
COPY orchestrator/ /app/orchestrator/
COPY alembic/ /app/alembic/
COPY alembic.ini /app/alembic.ini

# Base connector content-pack (Phase 3, docs/concepts/ENTITY-MODEL.md /
# docs/compose/specs/2026-07-30-content-as-contentpack-design.md) — baked
# into the image at build time, never fetched over the network (air-gap).
# Lives in a separate repo (D:/projects/soar-content-pack locally, sibling
# of this checkout), so it isn't part of this build context by default:
# `basepack` must be passed as an extra named build context, e.g.
#   docker buildx build --build-context basepack=../soar-content-pack -f deploy/prod/Dockerfile.orchestrator ...
# `deploy/soarctl_lib/bundle.py::build_images` passes this automatically
# for `soarctl package`. orchestrator/main.py::seed_connector_pack installs
# from here via the same pipeline as `soarctl content install` / POST
# /connectors/pack/install — every startup, not just once (closes E4).
# UNVERIFIED by an actual `docker build` as of this patch — see
# docs/compose/reports/content-as-contentpack.md, section on the Dockerfile
# changes, for what a human should check before this ships.
COPY --from=basepack . /app/base-pack/

# Platform venv — оркестратор и всё, от чего он зависит. Первый на PATH,
# поэтому голые `python`/`pip`/`alembic` (soarctl, docker exec) резолвятся
# сюда — поведение снаружи не меняется.
RUN python -m venv /app/platform-venv && \
    /app/platform-venv/bin/pip install --no-cache-dir -r /app/orchestrator/requirements.txt
ENV PATH="/app/platform-venv/bin:${PATH}"

# Content venv — soar/ + контракт зависимостей (soar/runtime_contract.py).
# НЕ на PATH: граница зависимостей физическая, а не "не забыть отдельно
# активировать" — см. docs/concepts/ENTITY-MODEL.md, решение 3.
RUN python -m venv /app/content-venv && \
    /app/content-venv/bin/pip install --no-cache-dir -r /app/soar/requirements.txt

RUN mkdir -p /app/data /app/data/workflows /app/data/actions /app/data/connectors /app/data/state /var/log/soar/jobs && \
    chown -R soar:soar /app /var/log/soar

# state_dir (soar/tools/watermark.py — WatermarkStore/SeenStore) is the one
# place workflow content writes outside its per-job scoped connectors_dir;
# group-own it soar-runner and open group-write so the runner subprocess
# can still persist watermarks after dropping to soar-runner (Фаза 4 [S3]).
# Everything else under /app/data stays soar:soar mode 755 — soar-runner
# gets read+execute (traverse) on it as `other`, same as before, but no
# write: it can import workflows/actions/connector code, never touch the
# git-tracked directories itself (workflows_repo — see git.workflows_repo).
RUN chown soar:soar-runner /app/data/state && chmod 770 /app/data/state

ENV PYTHONUNBUFFERED=1
ENV SOAR_CONFIG=/app/config.yaml
ENV SOAR_CONTENT_PYTHON=/app/content-venv/bin/python
ENV SOAR_BASE_PACK_PATH=/app/base-pack

EXPOSE 8000

USER soar

CMD ["uvicorn", "orchestrator.main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "/app"]
