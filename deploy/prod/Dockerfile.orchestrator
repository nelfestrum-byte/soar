FROM python:3.11-slim

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

RUN groupadd -r soar && useradd -r -g soar -d /app -s /sbin/nologin soar

WORKDIR /app

COPY soar/ /app/soar/
COPY orchestrator/ /app/orchestrator/
COPY alembic/ /app/alembic/
COPY alembic.ini /app/alembic.ini

# Base connector content-pack (Phase 3, docs/concepts/ENTITY-MODEL.md /
# docs/compose/specs/2026-07-30-content-as-contentpack-design.md) — baked
# into the image at build time, never fetched over the network (air-gap).
# Lives in a separate repo (D:/projects/soar-content-pack locally, sibling
# of this checkout), so it isn't part of this build context by default:
# `basepack` must be passed as an extra named build context, e.g.
#   docker buildx build --build-context basepack=../soar-content-pack -f deploy/prod/Dockerfile.orchestrator ...
# `deploy/soarctl_lib/bundle.py::build_images` passes this automatically
# for `soarctl package`. orchestrator/main.py::seed_connector_pack installs
# from here via the same pipeline as `soarctl content install` / POST
# /connectors/pack/install — every startup, not just once (closes E4).
# UNVERIFIED by an actual `docker build` as of this patch — see
# docs/compose/reports/content-as-contentpack.md, section on the Dockerfile
# changes, for what a human should check before this ships.
COPY --from=basepack . /app/base-pack/

# Platform venv — оркестратор и всё, от чего он зависит. Первый на PATH,
# поэтому голые `python`/`pip`/`alembic` (soarctl, docker exec) резолвятся
# сюда — поведение снаружи не меняется.
RUN python -m venv /app/platform-venv && \
    /app/platform-venv/bin/pip install --no-cache-dir -r /app/orchestrator/requirements.txt
ENV PATH="/app/platform-venv/bin:${PATH}"

# Content venv — soar/ + контракт зависимостей (soar/runtime_contract.py).
# НЕ на PATH: граница зависимостей физическая, а не "не забыть отдельно
# активировать" — см. docs/concepts/ENTITY-MODEL.md, решение 3.
RUN python -m venv /app/content-venv && \
    /app/content-venv/bin/pip install --no-cache-dir -r /app/soar/requirements.txt

RUN mkdir -p /app/data /app/data/workflows /app/data/actions /app/data/connectors /var/log/soar/jobs && \
    chown -R soar:soar /app /var/log/soar

ENV PYTHONUNBUFFERED=1
ENV SOAR_CONFIG=/app/config.yaml
ENV SOAR_CONTENT_PYTHON=/app/content-venv/bin/python
ENV SOAR_BASE_PACK_PATH=/app/base-pack

EXPOSE 8000

USER soar

CMD ["uvicorn", "orchestrator.main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "/app"]
